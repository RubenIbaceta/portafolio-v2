<script>
  type Language = 'es' | 'en';
  const languageButtons = document.querySelectorAll<HTMLButtonElement>('[data-language]');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const greeting = document.getElementById('typed-greeting');
  const firstName = document.getElementById('typed-first-name');
  const lastName = document.getElementById('typed-last-name');
  const role = document.getElementById('typed-role');
  let typingTimer: ReturnType<typeof setTimeout> | undefined;
  let activeLanguage: Language = 'es';

  function startTyping(language: Language) {
    clearTimeout(typingTimer);
    if (!greeting || !firstName || !lastName || !role) return;
    const greetingText = language === 'es' ? 'Hola, soy' : "Hi, I'm";
    const roles = language === 'es'
      ? ['Desarrollador backend', 'Estudiante de Ingeniería en Informática', 'Analista Programador']
      : ['Backend Developer', 'Computer Engineering Student', 'Systems Analyst'];
    if (reducedMotion.matches) {
      greeting.textContent = greetingText;
      firstName.textContent = 'Rubén';
      lastName.textContent = 'Ibaceta';
      role.textContent = roles[0];
      return;
    }
    greeting.textContent = '';
    firstName.textContent = '';
    lastName.textContent = '';
    role.textContent = '';

    function typeText(element: HTMLElement, text: string, done: () => void) {
      let position = 0;
      function nextCharacter() {
        element.textContent = text.slice(0, ++position);
        typingTimer = setTimeout(position < text.length ? nextCharacter : done, position < text.length ? 65 : 220);
      }
      nextCharacter();
    }

    let roleIndex = 0;
    function cycleRole() {
      if (!role) return;
      typeText(role, roles[roleIndex]!, () => {
        typingTimer = setTimeout(eraseRole, 2600);
      });
    }
    function eraseRole() {
      if (!role) return;
      role.textContent = (role.textContent ?? '').slice(0, -1);
      if (role.textContent) typingTimer = setTimeout(eraseRole, 32);
      else {
        roleIndex = (roleIndex + 1) % roles.length;
        typingTimer = setTimeout(cycleRole, 300);
      }
    }
    typeText(greeting, greetingText, () => {
      typeText(firstName, 'Rubén', () => {
        typeText(lastName, 'Ibaceta', cycleRole);
      });
    });
  }

  function setLanguage(language: Language) {
    activeLanguage = language;
    document.documentElement.lang = language;
    document.querySelectorAll<HTMLElement>('[data-es][data-en]').forEach(element => {
      element.textContent = element.dataset[language] ?? '';
    });
    document.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[data-es-ph]').forEach(element => {
      element.placeholder = element.getAttribute(`data-${language}-ph`) ?? '';
    });
    document.querySelectorAll<HTMLElement>('[data-es-label]').forEach(element => {
      element.setAttribute('aria-label', element.getAttribute(`data-${language}-label`) ?? '');
    });
    document.querySelectorAll<HTMLImageElement>('[data-es-alt]').forEach(element => {
      element.alt = element.getAttribute(`data-${language}-alt`) ?? '';
    });
    languageButtons.forEach(button => button.setAttribute('aria-pressed', String(button.dataset.language === language)));
    document.title = language === 'es' ? 'Rubén Ibaceta | Desarrollo Backend & Full Stack' : 'Rubén Ibaceta | Backend & Full-Stack Developer';
    startTyping(language);
    try { localStorage.setItem('portfolio-language', language); } catch { /* Funciona también sin almacenamiento. */ }
  }
  let initialLanguage: Language = navigator.language.toLowerCase().startsWith('es') ? 'es' : 'en';
  try {
    const saved = localStorage.getItem('portfolio-language');
    if (saved === 'es' || saved === 'en') initialLanguage = saved;
  } catch { /* Mantiene el idioma del navegador. */ }
  setLanguage(initialLanguage);
  languageButtons.forEach(button => button.addEventListener('click', () => {
    setLanguage(button.dataset.language === 'en' ? 'en' : 'es');
  }));
  reducedMotion.addEventListener('change', () => startTyping(activeLanguage));
  window.addEventListener('pagehide', () => clearTimeout(typingTimer));
  window.addEventListener('pageshow', event => {
    if (event.persisted) startTyping(activeLanguage);
  });
</script>
