  { label: 'Frontend', items: ['React', 'TypeScript', 'JavaScript', 'Astro', 'Tailwind CSS'] },
  { label: 'Datos / Data', items: ['PostgreSQL', 'Prisma', 'MySQL', 'MongoDB'] },
  { label: 'Cloud & tools', items: ['AWS EC2', 'Render', 'Neon', 'Docker', 'Linux', 'Git / GitHub'] },
